{
    "name": "tanuki",
    "private": true,
    "version": "0.0.0",
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "tsc -b && vite build",
        "typecheck": "tsc -b --pretty false",
        "lint": "oxlint .",
        "test": "vitest run",
        "test:watch": "vitest",
        "format": "prettier --write \"src/**/*.{ts,tsx,css}\" vite.config.ts index.html tsconfig.json tsconfig.app.json tsconfig.node.json package.json .oxlintrc.json .prettierrc.json",
        "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\" vite.config.ts index.html tsconfig.json tsconfig.app.json tsconfig.node.json package.json .oxlintrc.json .prettierrc.json",
        "preview": "vite preview"
    },
    "dependencies": {
        "@daypicker/react": "^10.0.1",
        "country-flag-icons": "^1.6.20",
        "firebase": "^12.18.0",
        "lucide-react": "^1.40.0",
        "react": "^19.2.8",
        "react-dom": "^19.2.8",
        "react-router-dom": "^7.18.3",
        "zustand": "^5.0.15"
    },
    "devDependencies": {
        "@testing-library/dom": "^10.4.1",
        "@testing-library/jest-dom": "^7.0.1",
        "@testing-library/react": "^16.3.3",
        "@testing-library/user-event": "^14.6.7",
        "@types/node": "^24.13.3",
        "@types/react": "^19.2.18",
        "@types/react-dom": "^19.2.4",
        "@vitejs/plugin-react": "^6.1.1",
        "jsdom": "^29.1.1",
        "oxlint": "^1.79.0",
        "prettier": "^3.9.6",
        "typescript": "~6.0.2",
        "vite": "^8.2.2",
        "vitest": "^5.0.0"
    }
}
